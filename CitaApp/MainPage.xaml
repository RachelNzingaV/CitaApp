<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CitaApp.MainPage"
             Title="Citas">

    <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">
        <Label Text="Citas médicas" 
               FontSize="24" 
               HorizontalOptions="Center" 
               FontAttributes="Bold" />

        <Button Text="Solicitar cita" 
                Clicked="OnSolicitarCitaClicked" />

        <Button Text="Consulta de citas" 
                Clicked="OnConsultaCitasClicked" />
    </VerticalStackLayout>
</ContentPage>
